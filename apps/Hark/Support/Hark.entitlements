<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (required for notarization) blocks microphone access
	     unless the app declares it. Not sandboxed: the event tap, the paste
	     injection and the Core Audio process taps all need the full runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
