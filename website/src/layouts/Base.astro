---
import "../styles/global.css";
import Lockup from "../components/Lockup.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** og:title for share cards; defaults to the page title with any
      "| Hark" suffix stripped, since og:site_name already carries it. */
  ogTitle?: string;
}
const { title, description, image = "/og/card.png" } = Astro.props;
const ogTitle = Astro.props.ogTitle ?? title.split(" | ")[0];
const path = Astro.url.pathname;
const canonical = new URL(path === "/index" ? "/" : path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const SOURCE = "https://github.com/tjameswilliams/hark";

const nav = [
  { href: "/", label: "Overview" },
  { href: "/download", label: "Download" },
  { href: "/privacy", label: "Privacy" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Hark",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS 15+",
    url: Astro.site?.href,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/licenses/MIT",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161412" />
    <meta property="og:site_name" content="Hark" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Hark mark, a Red-tailed Hawk calling the word HARK, over the line: Hold a key. Speak. Release." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a href="/" class="home" aria-label="Hark home">
          <Lockup height={40} />
        </a>
        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href || (item.href === "/" && path === "/index") ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a href={SOURCE}>Source</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>Open source, MIT or Apache-2.0. Speech model by NVIDIA via FluidAudio, CC-BY-4.0.</span>
        <span>
          <a href="/privacy">Privacy</a> · <a href={SOURCE}>Source</a>
        </span>
      </footer>
    </div>
  </body>
</html>
